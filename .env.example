# Port to listen on (Railway sets this automatically)
PORT=3000

# Enables AI summaries. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the model used for summaries (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest

# Database — pick ONE:
# 1) PostgreSQL (recommended on Railway): reference your Postgres service's URL
# DATABASE_URL=postgresql://user:pass@host:5432/sprout
# 2) SQLite (default when DATABASE_URL is unset). On Railway, attach a Volume
#    and point DATA_DIR at its mount path so data survives redeploys.
# DATA_DIR=/data
